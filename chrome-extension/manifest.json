{
  "manifest_version": 3,
  "name": "leakdownload Catcher",
  "version": "1.0",
  "description": "Bắt link tải từ trình duyệt và gửi về leakdownload app",
  "permissions": ["downloads", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "leakdownload Catcher",
    "default_popup": "popup.html"
  }
}
